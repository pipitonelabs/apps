server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Read-only Prometheus proxy: only instant and range queries, GET only.
  location = /api/v1/query {
    limit_except GET { deny all; }
    proxy_pass ${PROM_URL}/api/v1/query;
  }
  location = /api/v1/query_range {
    limit_except GET { deny all; }
    proxy_pass ${PROM_URL}/api/v1/query_range;
  }
  location /api/ {
    return 404;
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
