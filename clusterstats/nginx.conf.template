server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  # Read-only Prometheus proxy: only instant and range queries, GET only.
  location = /api/v1/query {
    limit_except GET { deny all; }
    proxy_pass ${PROM_URL}/api/v1/query;
  }
  location = /api/v1/query_range {
    limit_except GET { deny all; }
    proxy_pass ${PROM_URL}/api/v1/query_range;
  }
  location /api/ {
    return 404;
  }

  # Read-only kromgo proxy: /kromgo/<badge id> -> kromgo's JSON for that badge, GET only.
  location /kromgo/ {
    limit_except GET { deny all; }
    rewrite ^/kromgo/([a-z0-9_]+)$ /badges/$1?format=json? break;
    return 404;
    proxy_pass ${KROMGO_URL};
  }

  # Read-only playback sessions. The API keys are added here and never reach the browser.
  location = /streams/plex {
    limit_except GET { deny all; }
    rewrite ^ /api/v2?cmd=get_activity&apikey=${TAUTULLI_API_KEY}? break;
    proxy_pass ${TAUTULLI_URL};
  }
  location = /streams/jellyfin {
    limit_except GET { deny all; }
    rewrite ^ /Sessions?activeWithinSeconds=60? break;
    # Jellyfin 12 only accepts the Authorization header; the legacy X-Emby-Token header is rejected.
    proxy_set_header Authorization 'MediaBrowser Token="${JELLYFIN_API_KEY}"';
    proxy_pass ${JELLYFIN_URL};
  }
  location /streams/ {
    return 404;
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
